{
  "name": "newall-network",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "tsc --noEmit && bun run scripts/build.ts",
    "build:vite": "tsc --noEmit && vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:ui": "vitest --ui",
    "content:validate": "tsx scripts/verify-content.ts",
    "schema:generate": "tsx scripts/generate-schema.ts",
    "fonts:optimize": "tsx scripts/optimize-fonts.ts",
    "prepare": "husky install"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tanstack/react-router": "^1.80.0",
    "i18next": "^24.0.0",
    "react-i18next": "^15.0.0",
    "lenis": "^1.1.0",
    "motion": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@esbuild/linux-arm64": "^0.28.2",
    "@eslint/js": "^9.10.0",
    "@playwright/test": "^1.47.0",
    "@rollup/rollup-android-arm64": "^4.68.2",
    "@rollup/rollup-linux-arm64-gnu": "^4.68.2",
    "@rollup/rollup-linux-x64-gnu": "^4.68.2",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitejs/plugin-react": "3",
    "clsx": "^2.1.1",
    "esbuild": "0.18.20",
    "eslint": "^9.10.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "husky": "^9.1.0",
    "knip": "^5.30.0",
    "lightningcss": "^1.25.0",
    "prettier": "^3.3.0",
    "react-helmet-async": "^3.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "4",
    "vitest": "^2.1.0"
  },
  "trustedDependencies": ["@tailwindcss/vite", "lightningcss", "esbuild"]
}